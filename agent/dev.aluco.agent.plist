<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.aluco.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/aluco-agent</string>
  </array>
  <key>StartInterval</key>
  <integer>600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/var/log/aluco-agent.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/aluco-agent.log</string>
</dict>
</plist>
