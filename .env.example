# Vorlage für lokale Einstellungen. Kopieren nach .env (gitignored) und ausfüllen.
# Niemals echte Werte in diese Datei schreiben.

# Zeitzone für Container und Protokolle (z. B. Europe/Berlin)
TZ=UTC

# Aufbewahrung der Protokolle in Tagen (Standard laut Architektur: 30)
ALUCO_RETENTION_DAYS=30

# Ablage für Konfiguration und Datenbanken der Container (gitignored, regelmäßig sichern)
ALUCO_DATA_DIR=./data

# Speichergrenzen (bei Server mit wenig RAM reduzieren)
ADGUARD_MEM_LIMIT=512m
NETALERTX_MEM_LIMIT=1024m

# NetAlertX-Oberfläche
NETALERTX_LISTEN_ADDR=0.0.0.0
NETALERTX_PORT=20211
NETALERTX_GRAPHQL_PORT=20212
