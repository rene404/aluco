# Vorlage für lokale Einstellungen. Kopieren nach .env (gitignored) und ausfüllen.
# Niemals echte Werte in diese Datei schreiben.

# Zeitzone für Container und Protokolle (z. B. Europe/Berlin)
TZ=UTC

# Aufbewahrung der Protokolle in Tagen (Standard laut Architektur: 30)
ALUCO_RETENTION_DAYS=30

# Ablage für Konfiguration und Datenbanken der Container (gitignored, regelmäßig sichern)
ALUCO_DATA_DIR=./data

# Speichergrenzen (bei Server mit wenig RAM reduzieren)
ADGUARD_MEM_LIMIT=512m
NETALERTX_MEM_LIMIT=1024m

# NetAlertX-Oberfläche
NETALERTX_LISTEN_ADDR=0.0.0.0
NETALERTX_PORT=20211
NETALERTX_GRAPHQL_PORT=20212

# --- Aluco-Dienst ------------------------------------------------------------
# Abfrageintervall in Sekunden (mindestens 30)
ALUCO_INTERVAL_SECONDS=300
ALUCO_MEM_LIMIT=256m

# AdGuard Home (Login aus scripts/adguard-setup.sh)
ADGUARD_URL=http://127.0.0.1:80
ADGUARD_USER=admin
ADGUARD_PASSWORD=

# NetAlertX (Token: NetAlertX → Settings → API_TOKEN)
NETALERTX_URL=http://127.0.0.1:20212
NETALERTX_API_TOKEN=

# Meldungen per ntfy (leer = aus). Komplette Topic-URL, Topic-Name wie ein Passwort wählen.
NTFY_URL=
NTFY_TOKEN=
# Ab welchem Schweregrad melden: info, low, medium, high, critical
ALUCO_NOTIFY_MIN_SEVERITY=medium
# true = Meldung ohne Geräte-/Domainnamen (empfohlen bei öffentlichem ntfy-Server)
ALUCO_NOTIFY_MINIMAL=false

# --- Dashboard ---------------------------------------------------------------
# Passwort fürs Dashboard (mindestens 12 Zeichen). Nur im Heimnetz/VPN erreichbar machen.
ALUCO_DASHBOARD_PASSWORD=
ALUCO_WEB_PORT=8088
# true, sobald das Dashboard per HTTPS (z. B. über einen Reverse-Proxy) erreichbar ist
ALUCO_WEB_SECURE_COOKIES=false
ALUCO_WEB_MEM_LIMIT=256m

# --- KI-Vorbewertung (optional) ----------------------------------------------
# Neue Vorfälle von Claude vorbewerten lassen. Gesendet werden nur Regel, Schweregrad,
# Vertrauensstufe, Hersteller und ggf. die Domain – nie Gerätename, Hostname, IP, MAC
# oder Notizen; Firmengeräte nie. Details: docs/ai.md
ALUCO_AI_ENABLED=false
ANTHROPIC_API_KEY=
ALUCO_AI_MODEL=claude-opus-5-5
# Höchstens so viele Bewertungen pro Lauf (Kostenbremse)
ALUCO_AI_MAX_PER_RUN=5
