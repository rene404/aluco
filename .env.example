# Vorlage für lokale Einstellungen. Kopieren nach .env (gitignored) und ausfüllen.
# Niemals echte Werte in diese Datei schreiben.

# Zeitzone für Container und Protokolle (z. B. Europe/Berlin)
TZ=UTC
# Sprache von Dashboard, Meldungen, Wochenbericht und MCP: de (Standard) oder en
ALUCO_LANGUAGE=de

# Aufbewahrung der Protokolle in Tagen (Standard laut Architektur: 30)
ALUCO_RETENTION_DAYS=30

# Ablage für Konfiguration und Datenbanken der Container (gitignored, regelmäßig sichern)
ALUCO_DATA_DIR=./data

# Speichergrenzen (bei Server mit wenig RAM reduzieren)
ADGUARD_MEM_LIMIT=512m
NETALERTX_MEM_LIMIT=1024m

# NetAlertX-Oberfläche
NETALERTX_LISTEN_ADDR=0.0.0.0
NETALERTX_PORT=20211
NETALERTX_GRAPHQL_PORT=20212

# --- Aluco-Dienst ------------------------------------------------------------
# Abfrageintervall in Sekunden (mindestens 30)
ALUCO_INTERVAL_SECONDS=300
ALUCO_MEM_LIMIT=256m

# AdGuard Home (Login aus scripts/adguard-setup.sh)
ADGUARD_URL=http://127.0.0.1:80
ADGUARD_USER=admin
ADGUARD_PASSWORD=

# NetAlertX (Token: NetAlertX → Settings → API_TOKEN)
NETALERTX_URL=http://127.0.0.1:20212
NETALERTX_API_TOKEN=

# Meldungen per ntfy (leer = aus). Komplette Topic-URL, Topic-Name wie ein Passwort wählen.
NTFY_URL=
NTFY_TOKEN=
# Ab welchem Schweregrad melden: info, low, medium, high, critical
ALUCO_NOTIFY_MIN_SEVERITY=medium
# true = Meldung ohne Geräte-/Domainnamen (empfohlen bei öffentlichem ntfy-Server)
ALUCO_NOTIFY_MINIMAL=false
# Wochenbericht per ntfy (nur Zahlen, keine Namen): on/off, Wochentag (mo … so), Stunde (0–23, Zeitzone TZ)
ALUCO_REPORT=on
ALUCO_REPORT_WEEKDAY=so
ALUCO_REPORT_HOUR=18

# --- Dashboard ---------------------------------------------------------------
# Passwort fürs Dashboard (mindestens 12 Zeichen). Nur im Heimnetz/VPN erreichbar machen.
ALUCO_DASHBOARD_PASSWORD=
ALUCO_WEB_PORT=8088
# true, sobald das Dashboard per HTTPS (z. B. über einen Reverse-Proxy) erreichbar ist
ALUCO_WEB_SECURE_COOKIES=false
# Hostnamen, unter denen das Dashboard erreichbar sein soll (Komma-getrennt), z. B. aluco.lan.
# IP-Adressen und localhost gehen immer. Schützt vor DNS-Rebinding.
ALUCO_WEB_ALLOWED_HOSTS=
ALUCO_WEB_MEM_LIMIT=256m

# --- HTTPS mit Caddy (optional, empfohlen): docker compose --profile https up -d --------
# Adressen, unter denen das Dashboard per HTTPS erreichbar sein soll (Komma-getrennt).
ALUCO_HTTPS_SITES=https://localhost:8443
# Hinter Caddy: Dashboard nur lokal lauschen lassen, Proxy-Header vertrauen, sichere Cookies.
# ALUCO_WEB_HOST=127.0.0.1
# ALUCO_WEB_TRUST_PROXY=true
# ALUCO_WEB_SECURE_COOKIES=true

# --- KI-Vorbewertung (optional) ----------------------------------------------
# Neue Vorfälle von Claude vorbewerten lassen. Gesendet werden nur Regel, Schweregrad,
# Vertrauensstufe, Hersteller und ggf. die Domain – nie Gerätename, Hostname, IP, MAC
# oder Notizen; Firmengeräte nie. Details: docs/ai.md
ALUCO_AI_ENABLED=false
# claude (Cloud, API-Schlüssel) oder ollama (lokales Modell, Daten bleiben im Heimnetz)
ALUCO_AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ALUCO_AI_MODEL=claude-opus-5-5
# Nur für ollama: Adresse des Ollama-Servers, Modell z. B. ALUCO_AI_MODEL=qwen3:4b
ALUCO_AI_OLLAMA_URL=
# Höchstens so viele Bewertungen pro Lauf (Kostenbremse)
ALUCO_AI_MAX_PER_RUN=5

# --- Bedrohungslisten (Regel "bekannte Schad-Domain") --------------------------
# Leer = Standard (HaGeZi Threat Intelligence Feeds, mini, ohne Schlüssel).
# Mehrere Listen: name=https-URL, durch Komma getrennt. "off" schaltet die Regel ab.
# Beispiel abuse.ch (kostenloser Auth-Key nötig):
#   hagezi-tif=https://raw.githubusercontent.com/hagezi/dns-blocklists/main/wildcard/tif.mini-onlydomains.txt,urlhaus=https://…
ALUCO_THREAT_FEEDS=

# --- Neu registrierte Domains (Regel "neu registrierte Domain", < 14 Tage) ------------
# Leer = Standard (HaGeZi NRD, letzte 14 Tage: ~5 Mio. Domains, ~90 MB Download pro Tag).
# "off" schaltet die Regel ab. Eigene Listen: name=https-URL (reine Domains), durch Komma getrennt.
ALUCO_NRD_FEEDS=
# Eigene oder bekannte neue Domains, die nie als "neu registriert" gelten (inkl. Subdomains)
ALUCO_NRD_ALLOW=

# --- OPNsense (Stufe 1, optional): Trennen + ARP-Tabelle – docs/opnsense.md ----------
OPNSENSE_URL=
OPNSENSE_API_KEY=
OPNSENSE_API_SECRET=
# SHA-256-Fingerprint des Firewall-Zertifikats (oder OPNSENSE_CA_FILE)
OPNSENSE_CERT_SHA256=
OPNSENSE_ALIAS=aluco_quarantine
OPNSENSE_ARP=true
